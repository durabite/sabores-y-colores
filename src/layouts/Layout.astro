---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Sabores y Colores | Diseño que conecta con intención",
  description = "Estudio creativo de branding, diseño web, redes sociales y tarjetas digitales. Damos color a tu marca con creatividad, diseño y estrategia.",
} = Astro.props;
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/image/favicon.svg" />
    <meta name="theme-color" content="#F4F1EF" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />

    <script>
      import '../scripts/barber-demo.ts';
      import { initCarousel } from '../scripts/carousel.ts';
      import { initPortfolio } from '../scripts/portfolio.ts';
      import { initApp } from '../scripts/app.ts';

      // Initialize interactive features on page load
      document.addEventListener('DOMContentLoaded', () => {
        initCarousel();
        initPortfolio();
        initApp();
      });
    </script>
  </body>
</html>
